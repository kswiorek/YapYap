flowchart TD
    subgraph SETUP ["Newcomer setup"]
        Intent{Setup intent}
        Gen["Genesis: create network identity\n(first admin)"]
        GenW["Append genesis events\nfold into local state"]
        Ready["Running: ready to sponsor others"]
        Join["Join: create identity\nshow QR with one-time secret"]
        Recov["Recover: import account key\nsend signed recovery request"]
        Wait["Wait for sponsor intro\n(bounded wait)"]
        Intent --> Gen --> GenW --> Ready
        Intent --> Join --> Wait
        Intent --> Recov --> Wait
    end

    subgraph SPONSOR ["Sponsor"]
        Scan["Scan newcomer QR"]
        Valid["Validate invite\n(check admin rights if granting admin)"]
        AppS["Append newcomer events\nto the global log"]
        SendIntro["Send intro to newcomer\nencrypted with the QR secret"]
        Scan --> Valid --> AppS --> SendIntro
    end

    subgraph JOIN ["Newcomer join"]
        Gate["Intro arrives\nlearn sponsor identity"]
        Sync["Sync the global log\nfrom the sponsor"]
        Fold["Fold events into local state\nconfirm own membership"]
        Done["Done: joined the mesh"]
        Dead["Timed out: start over"]
        Gate --> Sync --> Fold --> Done
    end

    subgraph RESP ["Recovery responder (any member)"]
        Check["Check the request\n(serving node, known account)"]
        AppR["Append the device\nto the global log"]
        Reply["Reply with intro\nencrypted with the request secret"]
        Check --> AppR --> Reply
    end

    Join -. " out-of-band QR " .-> Scan
    Recov -. " Tor " .-> Check
    SendIntro -. " Tor " .-> Gate
    Reply -. " Tor " .-> Gate
    Wait -. " wait expires " .-> Dead
    Sync -. " wait expires " .-> Dead
