import kotlin.time.Instant;
import org.yapyap.protocol.ContentId;
import org.yapyap.protocol.PeerId;
import org.yapyap.protocol.TransferId;

-- Relay side (docs/envelope-redesign.md §5.4): transfers deposited here by a seal's origin for
-- another device. Ciphertext only — the relay never holds a key. Forwarded only when whole, as a
-- new transfer carrying the same seal bytes. Rows go when the forward ends, the seal expires, an
-- idle reservation times out, or eviction picks them (forget after delivery).
CREATE TABLE file_relay_transfers (
    transfer_id TEXT AS TransferId NOT NULL PRIMARY KEY,
    seal_id BLOB AS ContentId NOT NULL,
    origin_device TEXT AS PeerId NOT NULL,
    final_target TEXT AS PeerId NOT NULL,
    chunk_size INTEGER NOT NULL,
    byte_from INTEGER NOT NULL,
    byte_to INTEGER NOT NULL,
    seal_bytes BLOB NOT NULL,
    -- RESERVED (admitted, chunks landing) | WHOLE (every chunk stored).
    status TEXT NOT NULL,
    reserved_bytes INTEGER NOT NULL,
    created_at INTEGER AS Instant NOT NULL,
    last_chunk_at INTEGER AS Instant NOT NULL,
    expires_at INTEGER AS Instant NOT NULL
);

-- Stored chunk ciphertext; the PK makes a re-sent chunk a no-op.
CREATE TABLE file_relay_chunks (
    transfer_id TEXT AS TransferId NOT NULL,
    chunk_index INTEGER NOT NULL,
    ciphertext BLOB NOT NULL,
    PRIMARY KEY (transfer_id, chunk_index),
    FOREIGN KEY (transfer_id) REFERENCES file_relay_transfers(transfer_id) ON DELETE CASCADE
);

insertFileRelayTransfer:
INSERT OR IGNORE INTO file_relay_transfers (
    transfer_id, seal_id, origin_device, final_target, chunk_size, byte_from, byte_to,
    seal_bytes, status, reserved_bytes, created_at, last_chunk_at, expires_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFileRelayTransfer:
SELECT * FROM file_relay_transfers WHERE transfer_id = ?;

selectFileRelayTransfers:
SELECT * FROM file_relay_transfers;

updateFileRelayTransferStatus:
UPDATE file_relay_transfers SET status = ? WHERE transfer_id = ?;

touchFileRelayTransfer:
UPDATE file_relay_transfers SET last_chunk_at = ? WHERE transfer_id = ?;

sumFileRelayReservedBytes:
SELECT COALESCE(SUM(reserved_bytes), 0) FROM file_relay_transfers;

-- Admission's eviction order: least recently fed first, whole transfers only.
selectFileRelayEvictionOrder:
SELECT transfer_id, reserved_bytes FROM file_relay_transfers ORDER BY last_chunk_at ASC, transfer_id ASC;

deleteFileRelayTransfer:
DELETE FROM file_relay_transfers WHERE transfer_id = ?;

insertFileRelayChunk:
INSERT OR IGNORE INTO file_relay_chunks (transfer_id, chunk_index, ciphertext) VALUES (?, ?, ?);

selectFileRelayChunkIndices:
SELECT chunk_index FROM file_relay_chunks WHERE transfer_id = ? ORDER BY chunk_index ASC;

selectFileRelayChunk:
SELECT ciphertext FROM file_relay_chunks WHERE transfer_id = ? AND chunk_index = ?;

countFileRelayChunks:
SELECT COUNT(*) FROM file_relay_chunks WHERE transfer_id = ?;
