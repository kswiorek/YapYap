import kotlin.time.Instant;
import org.yapyap.crypto.identity.AccountId;
import org.yapyap.orchestrator.dag.RoomId;
import org.yapyap.persistence.db.RoomMemberRole;
import org.yapyap.persistence.db.RoomMemberStatus;
import org.yapyap.persistence.db.RoomType;

CREATE TABLE rooms (
    room_id TEXT AS RoomId NOT NULL PRIMARY KEY,
    space_id TEXT,
    type TEXT AS RoomType NOT NULL,
    name TEXT NOT NULL,
    FOREIGN KEY (space_id) REFERENCES spaces(space_id)
);

CREATE TABLE room_members (
    room_id TEXT AS RoomId NOT NULL,
    account_id TEXT AS AccountId NOT NULL,
    role TEXT AS RoomMemberRole NOT NULL,
    status TEXT AS RoomMemberStatus NOT NULL,
    joined_timestamp INTEGER AS Instant NOT NULL,
    PRIMARY KEY (room_id, account_id),
    FOREIGN KEY (room_id) REFERENCES rooms(room_id),
    FOREIGN KEY (account_id) REFERENCES accounts(account_id)
);

selectAllMembersForRoom:
SELECT account_id, role FROM room_members WHERE room_id = ?;

selectRoomById:
SELECT * FROM rooms WHERE room_id = ?;

insertRoom:
INSERT OR REPLACE INTO rooms (room_id, space_id, type, name)
VALUES (?, ?, ?, ?);

ensureRoomExists:
INSERT OR IGNORE INTO rooms (room_id, space_id, type, name)
VALUES (:roomId, NULL, :type, :name);

insertRoomMember:
INSERT OR REPLACE INTO room_members (room_id, account_id, role, status, joined_timestamp)
VALUES (?, ?, ?, ?, ?);

removeRoomMember:
UPDATE room_members
SET status = 'REMOVED'
WHERE room_id = ? AND account_id = ?;

-- Rooms a peer belongs to (drives which rooms we exchange frontiers about in pings).
-- Access reader: REMOVED rows never grant sync access.
selectRoomsOfPeer:
SELECT r.room_id
FROM rooms r
JOIN room_members rm ON rm.room_id = r.room_id AND rm.status = 'ACTIVE'
JOIN devices d ON d.account_id = rm.account_id
WHERE d.device_id = :deviceId;

-- Chat rooms only (GLOBAL is the global projector's). Boot + GLOBAL-commit sweep.
selectAllChatRoomIds:
SELECT room_id FROM rooms WHERE room_id != :globalRoomId;

-- Genesis merge: targeted update, never INSERT OR REPLACE (preserves local-only
-- columns); provisional UNKNOWN rows are overwritten here. space_id rides
-- separately (see updateRoomSpaceId): a non-null space writes only once its row
-- exists, deferred otherwise (FK to spaces).
updateRoomFromGenesis:
UPDATE rooms SET name = :name, type = :type WHERE room_id = :roomId;

updateRoomSpaceId:
UPDATE rooms SET space_id = :spaceId WHERE room_id = :roomId;

-- Defensive convergence: rows outside the fold output shouldn't exist
-- (members.keys retains REMOVED); the delete keeps the projection exactly equal
-- to the fold output.
deleteRoomMembersNotIn:
DELETE FROM room_members WHERE room_id = :roomId AND account_id NOT IN :keep;

deleteAllRoomMembers:
DELETE FROM room_members WHERE room_id = :roomId;

CREATE INDEX rooms_space_idx ON rooms(space_id);
CREATE INDEX room_members_account_idx ON room_members(account_id);
