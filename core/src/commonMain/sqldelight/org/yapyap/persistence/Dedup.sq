import kotlin.uuid.Uuid;
import kotlin.time.Instant;
import org.yapyap.protocol.envelopes.PacketNackReason;

-- Dedup tracking for packets from not-yet-known peers (bootstrap): source_device_id
-- deliberately has NO FOREIGN KEY to devices. The first packet from a newcomer/recovering device
-- (intro / recovery request) arrives before any local row exists for its source; dedup must still
-- record it. source_device_id is only ever used as a lookup key, never joined.
CREATE TABLE dedup (
    packet_id TEXT AS Uuid NOT NULL,
    source_device_id TEXT NOT NULL,
    received_at INTEGER AS Instant NOT NULL,
    nack_reason TEXT AS PacketNackReason,
    PRIMARY KEY (source_device_id, packet_id)
);

insertDedup:
INSERT INTO dedup (
    packet_id,
    source_device_id,
    received_at
) VALUES (?, ?, ?);

selectDedupBySourceAndPacketId:
SELECT packet_id
FROM dedup
WHERE source_device_id = ?
  AND packet_id = ?
LIMIT 1;

clearPacket:
DELETE FROM dedup
WHERE packet_id = ? AND source_device_id = ?;

updateNackReason:
UPDATE dedup
SET
    nack_reason = ?
WHERE source_device_id = ? AND packet_id = ?;

getNackReason:
SELECT nack_reason
FROM dedup
WHERE source_device_id = ? AND packet_id = ?;

deleteDedupReceivedBefore:
DELETE FROM dedup
WHERE received_at < ?;

tryReservePacketId:
INSERT OR IGNORE INTO dedup (
    packet_id,
    source_device_id,
    received_at
) VALUES (?, ?, ?);

selectLastInsertChanges:
SELECT changes();

CREATE INDEX dedup_source_device_idx ON dedup(source_device_id);