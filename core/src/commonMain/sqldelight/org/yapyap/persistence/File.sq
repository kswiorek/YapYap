import kotlin.time.Instant;
import kotlin.uuid.Uuid;
import org.yapyap.protocol.FileId;
import org.yapyap.orchestrator.file.FileStorage;
import org.yapyap.orchestrator.file.FilePathKind;
import org.yapyap.orchestrator.file.FileDescriptorStatus;
import org.yapyap.orchestrator.file.FileReceiveStatus;

-- Orchestrator-owned permanent store index (design §13): what we hold.
-- Keys are per transfer and never stored here.
CREATE TABLE file_descriptors (
    file_id TEXT AS FileId NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    mime_type TEXT,
    total_bytes INTEGER NOT NULL,
    block_size INTEGER NOT NULL,
    -- Concatenated 32-byte per-block SHA-256 hashes; encoded/decoded in the repository.
    block_hashes BLOB NOT NULL,
    storage TEXT AS FileStorage NOT NULL,
    -- Store path for COPY; original path or content-URI string for REFERENCE.
    path TEXT NOT NULL,
    storage_kind TEXT AS FilePathKind NOT NULL,
    status TEXT AS FileDescriptorStatus NOT NULL,
    created_at INTEGER AS Instant NOT NULL,
    last_access_at INTEGER AS Instant NOT NULL
);

insertFileDescriptor:
INSERT OR REPLACE INTO file_descriptors (
    file_id, file_name, mime_type, total_bytes, block_size, block_hashes,
    storage, path, storage_kind, status, created_at, last_access_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFileDescriptorById:
SELECT * FROM file_descriptors WHERE file_id = ?;

deleteFileDescriptorById:
DELETE FROM file_descriptors WHERE file_id = ?;

updateFileDescriptorStatus:
UPDATE file_descriptors SET status = ? WHERE file_id = ?;

updateFileDescriptorAccess:
UPDATE file_descriptors SET last_access_at = ? WHERE file_id = ?;

updateFileDescriptorHeld:
UPDATE file_descriptors SET status = 'HELD', file_name = ?, mime_type = ?, total_bytes = ?, block_size = ?, block_hashes = ?, storage = ?, path = ?, storage_kind = ?, last_access_at = ? WHERE file_id = ?;

selectCopyDescriptorsOrderedByAccess:
SELECT * FROM file_descriptors WHERE storage = 'COPY' ORDER BY last_access_at ASC, created_at ASC, file_id ASC;

sumCopyBytes:
SELECT COALESCE(SUM(total_bytes), 0) FROM file_descriptors WHERE storage = 'COPY';

-- Orchestrator-owned receive state, fileId-scoped (design §13): coverage checkpoints,
-- block verification state and staging live here; incoming transfers merge into it.
-- Paths are derived from the fileId and the store layout, never stored.
CREATE TABLE file_receives (
    file_id TEXT AS FileId NOT NULL PRIMARY KEY,
    status TEXT AS FileReceiveStatus NOT NULL,
    total_bytes INTEGER NOT NULL,
    -- P: the coverage checkpoint, source of truth over the .part. Every block below P
    -- is verified.
    contiguous_bytes INTEGER NOT NULL,
    -- From the first OFFER, checked against the fileId; NULL until one lands.
    block_size INTEGER,
    -- Concatenated 32-byte per-block SHA-256 hashes; encoded/decoded in the repository.
    block_hashes BLOB,
    file_name TEXT,
    mime_type TEXT,
    hash_mismatches INTEGER NOT NULL,
    -- Discovered when a message referencing the file shows up; a receive still
    -- without one after the unreferenced retention is deleted with its file.
    origin_message_id TEXT AS Uuid,
    created_at INTEGER AS Instant NOT NULL,
    updated_at INTEGER AS Instant NOT NULL
);

insertFileReceive:
INSERT OR REPLACE INTO file_receives (
    file_id, status, total_bytes, contiguous_bytes, block_size, block_hashes,
    file_name, mime_type, hash_mismatches,
    origin_message_id, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFileReceiveById:
SELECT * FROM file_receives WHERE file_id = ?;

selectAllFileReceives:
SELECT * FROM file_receives;

selectActiveFileReceives:
SELECT * FROM file_receives WHERE status = 'IN_FLIGHT' OR status = 'STALLED';

selectReadyFileReceives:
SELECT * FROM file_receives WHERE status = 'READY';

updateFileReceiveProgress:
UPDATE file_receives
SET contiguous_bytes = ?, hash_mismatches = ?, status = ?, updated_at = ?
WHERE file_id = ?;

updateFileReceiveStatus:
UPDATE file_receives SET status = ?, updated_at = ? WHERE file_id = ?;

updateFileReceiveOrigin:
UPDATE file_receives SET origin_message_id = ?, updated_at = ? WHERE file_id = ?;

deleteFileReceiveById:
DELETE FROM file_receives WHERE file_id = ?;

-- Staged, not-yet-drained plaintext ranges (design §13): the chunk tracker absorbs
-- arbitrary arrival order and mixed chunkings; the writer itself never seeks.
CREATE TABLE file_receive_chunks (
    file_id TEXT AS FileId NOT NULL,
    start_offset INTEGER NOT NULL,
    length INTEGER NOT NULL,
    plaintext BLOB NOT NULL,
    PRIMARY KEY (file_id, start_offset)
);

insertFileReceiveChunk:
INSERT OR IGNORE INTO file_receive_chunks (file_id, start_offset, length, plaintext)
VALUES (?, ?, ?, ?);

selectFileReceiveChunksOverlapping:
SELECT * FROM file_receive_chunks
WHERE file_id = ? AND start_offset < :untilExclusive AND start_offset + length > :fromInclusive
ORDER BY start_offset ASC;

selectFileReceiveChunkRefsByFile:
SELECT file_id, start_offset, length FROM file_receive_chunks WHERE file_id = ? ORDER BY start_offset ASC;

sumFileReceiveStagedBytes:
SELECT COALESCE(SUM(length), 0) FROM file_receive_chunks WHERE file_id = ?;

deleteFileReceiveChunksByFile:
DELETE FROM file_receive_chunks WHERE file_id = ?;

deleteFileReceiveChunksBelow:
DELETE FROM file_receive_chunks WHERE file_id = ? AND start_offset + length <= ?;

CREATE INDEX file_receive_chunks_file_idx ON file_receive_chunks(file_id);
