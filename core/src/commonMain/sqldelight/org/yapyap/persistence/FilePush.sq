import kotlin.time.Instant;
import kotlin.uuid.Uuid;
import org.yapyap.protocol.FileId;
import org.yapyap.protocol.PeerId;
import org.yapyap.protocol.TransferId;
import org.yapyap.protocol.TransferKey;

-- Pusher-side per-device transfer state (design §13): per-depot resume points,
-- restart-recoverable from these rows plus the outbox. Status and kind are plain
-- strings mapped in the store.
CREATE TABLE file_pushes (
    transfer_id TEXT AS TransferId NOT NULL PRIMARY KEY,
    file_id TEXT AS FileId NOT NULL,
    target_device TEXT AS PeerId NOT NULL,
    -- Outer envelope target override: NULL for direct/serve pushes (outer == target),
    -- the relay for DEPOSIT rows (outer == relay, inner stays the ultimate target).
    via_relay TEXT AS PeerId,
    kind TEXT NOT NULL,
    total_bytes INTEGER NOT NULL,
    key BLOB AS TransferKey NOT NULL,
    chunk_size_bytes INTEGER NOT NULL,
    start_index INTEGER NOT NULL,
    next_chunk_index INTEGER NOT NULL,
    contiguous_acked INTEGER NOT NULL,
    marker_packet_id TEXT AS Uuid,
    status TEXT NOT NULL,
    created_at INTEGER AS Instant NOT NULL,
    expires_at INTEGER AS Instant NOT NULL,
    -- Deposit-round claim (design §6.4): set once when the round starts, NULL before.
    deposited_at INTEGER AS Instant
);

-- Chunk index recovery across restarts (design §6.2): the actor records packetId → index
-- when it enqueues, so a restart rebuilds `queued` from outbox rows instead of re-sealing.
CREATE TABLE file_push_chunks (
    transfer_id TEXT AS TransferId NOT NULL,
    chunk_index INTEGER NOT NULL,
    packet_id TEXT AS Uuid NOT NULL,
    PRIMARY KEY (transfer_id, chunk_index),
    FOREIGN KEY (transfer_id) REFERENCES file_pushes(transfer_id) ON DELETE CASCADE
);
CREATE INDEX file_push_chunks_packet_idx ON file_push_chunks(packet_id);

insertFilePush:
INSERT INTO file_pushes (
    transfer_id, file_id, target_device, via_relay, kind, total_bytes, key, chunk_size_bytes,
    start_index, next_chunk_index, contiguous_acked, marker_packet_id,
    status, created_at, expires_at, deposited_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFilePushById:
SELECT * FROM file_pushes WHERE transfer_id = ?;

selectLiveFilePushesByFileAndTarget:
SELECT * FROM file_pushes
WHERE file_id = :fileId AND target_device = :target
  AND (status = 'CREATED' OR status = 'IN_FLIGHT');

-- A new send to (file, device) starts a fresh generation: earlier finished transfers of
-- the pair stop counting toward the account's state and events.
deleteTerminalFilePushesByFileAndTarget:
DELETE FROM file_pushes
WHERE file_id = :fileId AND target_device = :target
  AND status != 'CREATED' AND status != 'IN_FLIGHT';

selectLiveFilePushes:
SELECT * FROM file_pushes WHERE status = 'CREATED' OR status = 'IN_FLIGHT';

selectFilePushesByFile:
SELECT * FROM file_pushes WHERE file_id = :fileId;

-- Terminal rows never change again: a late write from an actor that has not seen a COMPLETE
-- yet must not bring a finished transfer back.
updateFilePushStatus:
UPDATE file_pushes SET status = ? WHERE transfer_id = ? AND status IN ('CREATED', 'IN_FLIGHT');

updateFilePushMarker:
UPDATE file_pushes SET marker_packet_id = ? WHERE transfer_id = ?;

updateFilePushProgress:
UPDATE file_pushes SET next_chunk_index = ?, contiguous_acked = ? WHERE transfer_id = ? AND status IN ('CREATED', 'IN_FLIGHT');

-- Deposit-round claim (design §6.4): exactly one claimant per source transfer, restart-safe.
-- Only a live transfer deposits: a COMPLETE that landed meanwhile wins over the claim.
claimFilePushDeposited:
UPDATE file_pushes SET deposited_at = :now WHERE transfer_id = :id AND deposited_at IS NULL
    AND status IN ('CREATED', 'IN_FLIGHT');

-- Terminal rows past their TTL: the ticker deletes them with their key (invariant 5).
selectTerminalFilePushesBefore:
SELECT * FROM file_pushes
WHERE (status NOT IN ('CREATED', 'IN_FLIGHT')) AND expires_at <= ?;

deleteFilePushById:
DELETE FROM file_pushes WHERE transfer_id = ?;

insertFilePushChunk:
INSERT OR REPLACE INTO file_push_chunks (transfer_id, chunk_index, packet_id)
VALUES (?, ?, ?);

selectFilePushChunksByTransfer:
SELECT transfer_id, chunk_index, packet_id FROM file_push_chunks WHERE transfer_id = ?;

selectFilePushChunkByPacket:
SELECT transfer_id, chunk_index, packet_id FROM file_push_chunks WHERE packet_id = ?;

deleteFilePushChunkByPacket:
DELETE FROM file_push_chunks WHERE packet_id = ?;

deleteFilePushChunksByTransfer:
DELETE FROM file_push_chunks WHERE transfer_id = ?;

CREATE INDEX file_pushes_file_target_idx ON file_pushes(file_id, target_device);
