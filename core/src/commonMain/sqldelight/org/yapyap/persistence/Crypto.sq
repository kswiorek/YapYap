import kotlin.Boolean;
import kotlin.time.Instant;
import org.yapyap.crypto.e2ee.session.SessionRole;
import org.yapyap.crypto.e2ee.session.SessionStatus;
import org.yapyap.crypto.e2ee.session.X3dhMode;
import org.yapyap.protocol.PeerId;
import org.yapyap.persistence.db.OpkStatus;
import org.yapyap.crypto.keys.OneTimePreKeyId;
import org.yapyap.crypto.keys.EncryptionPublicKey;

CREATE TABLE crypto_sessions (
    session_id TEXT NOT NULL PRIMARY KEY,
    peer_device_id TEXT AS PeerId NOT NULL,
    canonical INTEGER AS Boolean NOT NULL,
    session_epoch INTEGER NOT NULL,
    session_generation INTEGER NOT NULL DEFAULT 1,
    root_key BLOB NOT NULL,
    send_chain_key BLOB,
    recv_chain_key BLOB,
    send_message_number INTEGER NOT NULL,
    recv_message_number INTEGER NOT NULL,
    previous_send_chain_length INTEGER NOT NULL,
    local_dh_private_key BLOB NOT NULL,
    local_dh_public_key BLOB NOT NULL,
    remote_dh_pub_key BLOB,
    role TEXT AS SessionRole NOT NULL,
    x3dh_mode TEXT AS X3dhMode NOT NULL,
    handshake_spk_id TEXT NOT NULL,
    handshake_opk_id TEXT,
    initiator_ephemeral_private_key BLOB,
    initiator_ephemeral_public_key BLOB,
    offered_opk_id TEXT,
    status TEXT AS SessionStatus NOT NULL,
    created_at_epoch_seconds INTEGER AS Instant NOT NULL,
    updated_at_epoch_seconds INTEGER AS Instant NOT NULL,
    FOREIGN KEY (peer_device_id) REFERENCES devices(device_id)
);

CREATE INDEX crypto_sessions_peer_device_idx ON crypto_sessions(peer_device_id);
CREATE UNIQUE INDEX crypto_sessions_peer_epoch_role_gen_idx
ON crypto_sessions(peer_device_id, session_epoch, role, session_generation);
CREATE UNIQUE INDEX crypto_sessions_one_canonical_per_epoch
ON crypto_sessions(peer_device_id, session_epoch)
WHERE canonical = 1;

CREATE TABLE crypto_session_skipped_keys (
    session_id TEXT NOT NULL REFERENCES crypto_sessions(session_id) ON DELETE CASCADE,
    dh_public_key BLOB NOT NULL,
    message_number INTEGER NOT NULL,
    message_key BLOB NOT NULL,
    PRIMARY KEY (session_id, dh_public_key, message_number)
);

CREATE INDEX crypto_session_skipped_keys_session_idx
ON crypto_session_skipped_keys(session_id);

insertOrReplaceCryptoSession:
INSERT OR REPLACE INTO crypto_sessions (
    session_id,
    peer_device_id,
    canonical,
    session_epoch,
    session_generation,
    root_key,
    send_chain_key,
    recv_chain_key,
    send_message_number,
    recv_message_number,
    previous_send_chain_length,
    local_dh_private_key,
    local_dh_public_key,
    remote_dh_pub_key,
    role,
    x3dh_mode,
    handshake_spk_id,
    handshake_opk_id,
    initiator_ephemeral_private_key,
    initiator_ephemeral_public_key,
    offered_opk_id,
    status,
    created_at_epoch_seconds,
    updated_at_epoch_seconds
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCryptoSessionSkippedKeysBySession:
DELETE FROM crypto_session_skipped_keys WHERE session_id = ?;

insertCryptoSessionSkippedKey:
INSERT INTO crypto_session_skipped_keys (session_id, dh_public_key, message_number, message_key)
VALUES (?, ?, ?, ?);

selectCryptoSessionByPeerAndEpochWithKeys:
SELECT cs.*, sk.dh_public_key AS skipped_dh_public_key, sk.message_number AS skipped_message_number, sk.message_key AS skipped_message_key
FROM crypto_sessions cs
LEFT JOIN crypto_session_skipped_keys sk ON sk.session_id = cs.session_id
WHERE cs.peer_device_id = ? AND cs.session_epoch = ?
ORDER BY cs.session_generation, cs.role;

setCanonicalByPeerEpochRoleAndGeneration:
UPDATE crypto_sessions
SET canonical = ?
WHERE peer_device_id = ? AND session_epoch = ? AND role = ? AND session_generation = ?;

selectCryptoSessionsByPeerWithKeys:
SELECT cs.*, sk.dh_public_key AS skipped_dh_public_key, sk.message_number AS skipped_message_number, sk.message_key AS skipped_message_key
FROM crypto_sessions cs
LEFT JOIN crypto_session_skipped_keys sk ON sk.session_id = cs.session_id
WHERE cs.peer_device_id = ?
ORDER BY cs.session_epoch, cs.session_generation, cs.role;

selectMaxSessionEpochByPeer:
SELECT MAX(session_epoch) AS max_epoch
FROM crypto_sessions
WHERE peer_device_id = ? AND status = 'ACTIVE';

markCryptoSessionSupersededByRoleAndGeneration:
UPDATE crypto_sessions
SET status = ?, updated_at_epoch_seconds = ?
WHERE peer_device_id = ? AND session_epoch = ? AND role = ? AND session_generation = ?;

markCryptoSessionSuperseded:
UPDATE crypto_sessions
SET status = ?, updated_at_epoch_seconds = ?
WHERE peer_device_id = ? AND session_epoch = ?;

deleteCryptoSessionByPeerEpochRoleAndGeneration:
DELETE FROM crypto_sessions
WHERE peer_device_id = ? AND session_epoch = ? AND role = ? AND session_generation = ?;

selectDistinctPeerDeviceIds:
SELECT DISTINCT peer_device_id
FROM crypto_sessions;

clearOfferedOpkId:
UPDATE crypto_sessions
SET offered_opk_id = NULL, updated_at_epoch_seconds = ?
WHERE offered_opk_id = ?;

-- This device's one-time prekeys (crypto-owned; private halves live in the keyring).
CREATE TABLE one_time_prekeys (
    opk_id TEXT AS OneTimePreKeyId NOT NULL PRIMARY KEY,
    device_id TEXT AS PeerId NOT NULL,
    public_key BLOB AS EncryptionPublicKey NOT NULL,
    status TEXT AS OpkStatus NOT NULL DEFAULT 'ALLOCATED',
    created_at_epoch_seconds INTEGER AS Instant NOT NULL,
    offered_at_epoch_seconds INTEGER AS Instant,
    FOREIGN KEY (device_id) REFERENCES devices(device_id)
);

insertOneTimePreKey:
INSERT OR REPLACE INTO one_time_prekeys (
    opk_id,
    device_id,
    public_key,
    status,
    created_at_epoch_seconds,
    offered_at_epoch_seconds
) VALUES (?, ?, ?, ?, ?, ?);

selectOneTimePreKeyById:
SELECT *
FROM one_time_prekeys
WHERE opk_id = ?;

markOneTimePreKeyOffered:
UPDATE one_time_prekeys
SET status = ?, offered_at_epoch_seconds = ?
WHERE opk_id = ? AND device_id = ? AND status = 'ALLOCATED';

markOneTimePreKeyConsumed:
UPDATE one_time_prekeys
SET status = 'CONSUMED'
WHERE opk_id = ? AND device_id = ? AND status = 'OFFERED';

selectExpiredOfferedOneTimePreKeys:
SELECT opk_id
FROM one_time_prekeys
WHERE device_id = ?
  AND status = 'OFFERED'
  AND offered_at_epoch_seconds IS NOT NULL
  AND offered_at_epoch_seconds < ?;

selectOneTimePreKeyIdsForDevice:
SELECT opk_id
FROM one_time_prekeys
WHERE device_id = ?;

deleteOneTimePreKeyById:
DELETE FROM one_time_prekeys
WHERE opk_id = ? AND device_id = ?;

CREATE INDEX one_time_prekeys_device_idx ON one_time_prekeys(device_id);
CREATE INDEX one_time_prekeys_device_status_offered_idx
ON one_time_prekeys(device_id, status, offered_at_epoch_seconds);
