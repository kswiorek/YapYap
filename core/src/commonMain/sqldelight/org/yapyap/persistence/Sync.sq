import kotlin.uuid.Uuid;
import kotlin.time.Instant;
import org.yapyap.crypto.identity.AccountId;
import org.yapyap.protocol.RoomId;
import org.yapyap.protocol.PeerId;

-- One row per missing message: the sync targets exactly one message ID (a gap
-- parent from a causal hold, or a frontier tip learned from a ping). Orphan- and
-- ping-triggered syncs share this single shape; the responder serves the target
-- plus its ancestry down to the requester's known frontier.
CREATE TABLE pending_syncs(
    sync_id TEXT AS Uuid NOT NULL PRIMARY KEY,
    room_id TEXT AS RoomId NOT NULL,
    target_message_id TEXT AS Uuid NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER AS Instant NOT NULL,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id),
    UNIQUE (room_id, target_message_id)
);

CREATE TABLE pending_sync_candidate_accounts(
    sync_id TEXT AS Uuid NOT NULL,
    account_id TEXT AS AccountId NOT NULL,
    PRIMARY KEY (sync_id, account_id),
    FOREIGN KEY (sync_id) REFERENCES pending_syncs(sync_id) ON DELETE CASCADE
);

CREATE TABLE pending_sync_attempted_peers(
    sync_id TEXT AS Uuid NOT NULL,
    device_id TEXT AS PeerId NOT NULL,
    PRIMARY KEY (sync_id, device_id),
    FOREIGN KEY (sync_id) REFERENCES pending_syncs(sync_id) ON DELETE CASCADE
);

insertPendingSync:
INSERT OR IGNORE INTO pending_syncs (sync_id, room_id, target_message_id, attempts, next_attempt_at)
VALUES (?, ?, ?, 0, ?);

insertPendingSyncCandidateAccount:
INSERT OR IGNORE INTO pending_sync_candidate_accounts (sync_id, account_id)
VALUES (?, ?);

findSyncByTarget:
SELECT * FROM pending_syncs
WHERE room_id = :roomId AND target_message_id = :target;

selectSyncById:
SELECT * FROM pending_syncs WHERE sync_id = ?;

deleteSync:
DELETE FROM pending_syncs WHERE sync_id = ?;

deleteSyncsByTarget:
DELETE FROM pending_syncs WHERE room_id = :roomId AND target_message_id = :target;

selectEarliestDueAt:
SELECT MIN(next_attempt_at) FROM pending_syncs;

selectDueSyncs:
SELECT * FROM pending_syncs WHERE next_attempt_at <= ? LIMIT ?;

selectCandidateAccountsForSync:
SELECT account_id FROM pending_sync_candidate_accounts WHERE sync_id = ?;

selectAttemptedPeersForSync:
SELECT device_id FROM pending_sync_attempted_peers WHERE sync_id = ?;

recordAttempt:
UPDATE pending_syncs SET attempts = attempts + 1, next_attempt_at = ? WHERE sync_id = ?;

updateNextAttemptAt:
UPDATE pending_syncs SET next_attempt_at = ? WHERE sync_id = ?;

insertAttemptedPeer:
INSERT OR IGNORE INTO pending_sync_attempted_peers (sync_id, device_id) VALUES (?, ?);

-- Appends [accountId] to every pending sync row in [roomId] (insert-if-absent).
-- Append-only, never replace: room-scoped accumulation preserves candidates other
-- triggers contributed (ping senders for unknown rooms, message authors), which a
-- recompute would silently drop. Used by the membership refresh and, per row, by
-- the ping/message accumulation paths (via insertPendingSyncCandidateAccount).
appendCandidateAccountsForRoom:
INSERT OR IGNORE INTO pending_sync_candidate_accounts (sync_id, account_id)
SELECT sync_id, :accountId FROM pending_syncs WHERE room_id = :roomId;

-- Re-opens [deviceId] (only) on [roomId]'s inert rows: rows with no eligible
-- device left. A ping about the room from this device is that device's assertion
-- that its projection has us in the room, contradicting its own gate-NACK
-- (docs/room events.md §6) — so the NACK is treated as stale and the device may
-- be asked again. Gated on inertness (NOT EXISTS): mid-round rotation is
-- untouched, so the tier-preferred device cannot hog all requests while other
-- candidates never get a turn.
--
-- The eligibility half mirrors DefaultSyncPeerPolicy + SyncRetryProcessor:
-- candidate accounts' non-banned, non-local devices minus attempted. The tier
-- preference below it (session/online) is reachability observed at send time,
-- which this statement cannot see; a test pins the intent.
reopenAttemptedPeerForRoom:
DELETE FROM pending_sync_attempted_peers
WHERE device_id = :deviceId
  AND sync_id IN (
    SELECT ps.sync_id FROM pending_syncs ps
    WHERE ps.room_id = :roomId
      AND NOT EXISTS (
        SELECT 1 FROM pending_sync_candidate_accounts pca
        JOIN devices d ON d.account_id = pca.account_id
        WHERE pca.sync_id = ps.sync_id
          AND d.status != 'BANNED'
          AND d.device_id != :localDeviceId
          AND d.device_id NOT IN (
            SELECT device_id FROM pending_sync_attempted_peers WHERE sync_id = ps.sync_id
          )
      )
  );

accelerateForOnlinePeer:
UPDATE pending_syncs
SET next_attempt_at = :now
WHERE next_attempt_at > :now
  AND sync_id IN (
    SELECT psca.sync_id
    FROM pending_sync_candidate_accounts psca
    JOIN devices d ON d.account_id = psca.account_id
    WHERE d.device_id = :deviceId
  );

CREATE INDEX pending_syncs_room_idx ON pending_syncs(room_id);
CREATE INDEX pending_syncs_due_idx ON pending_syncs(next_attempt_at);
CREATE INDEX pending_sync_attempted_peers_device_idx ON pending_sync_attempted_peers(device_id);
