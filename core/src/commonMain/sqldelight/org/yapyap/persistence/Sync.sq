import kotlin.uuid.Uuid;
import org.yapyap.protocol.PeerId;
import org.yapyap.protocol.envelopes.SyncRequestKind;

CREATE TABLE pending_syncs(
    sync_id TEXT AS Uuid PRIMARY KEY,
    room_id TEXT NOT NULL,
    sync_request_kind TEXT AS SyncRequestKind NOT NULL,        -- GAP | RANGE
    request_payload BLOB NOT NULL,           -- encoded SyncRequest bytes
    missing_ancestor_of TEXT AS Uuid,                -- nullable; GAP only, for fulfillment matching
    candidate_accounts TEXT NOT NULL,        -- JSON/CSV of AccountId (coordinator's input)
    status TEXT NOT NULL DEFAULT 'PENDING', -- PENDING | IN_FLIGHT | FULFILLED | ABANDONED
    attempts INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER NOT NULL,        -- epoch seconds; drives the loop
    target_device_id TEXT AS PeerId,                    -- nullable; set by loop during IN_FLIGHT
    created_at INTEGER NOT NULL,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id)
);