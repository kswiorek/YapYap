-- File transfer (docs/file/design.md §13): drops the placeholder file tables and creates
-- the attachment index, the orchestrator's store, receive and request state, and routing's
-- push, incoming, request and relay state. Runs with foreign keys off (see DatabaseInitializer).
DROP INDEX IF EXISTS file_chunk_tracker_status_idx;
DROP INDEX IF EXISTS file_transfers_message_idx;
DROP TABLE IF EXISTS file_chunk_tracker;
DROP TABLE IF EXISTS file_transfers;

CREATE TABLE message_attachments (
    message_id TEXT NOT NULL,
    file_id TEXT NOT NULL,
    PRIMARY KEY (message_id, file_id),
    FOREIGN KEY (message_id) REFERENCES messages(message_id) ON DELETE CASCADE
);

CREATE INDEX message_attachments_file_idx ON message_attachments(file_id);

CREATE TABLE file_descriptors (
    file_id TEXT NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    mime_type TEXT,
    total_bytes INTEGER NOT NULL,
    block_size INTEGER NOT NULL,
    block_hashes BLOB NOT NULL,
    storage TEXT NOT NULL,
    path TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE file_receives (
    file_id TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL,
    total_bytes INTEGER NOT NULL,
    contiguous_bytes INTEGER NOT NULL,
    block_size INTEGER,
    block_hashes BLOB,
    file_name TEXT,
    mime_type TEXT,
    hash_mismatches INTEGER NOT NULL,
    part_path TEXT NOT NULL,
    final_path TEXT NOT NULL,
    origin_message_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE file_receive_chunks (
    file_id TEXT NOT NULL,
    start_offset INTEGER NOT NULL,
    length INTEGER NOT NULL,
    plaintext BLOB NOT NULL,
    PRIMARY KEY (file_id, start_offset)
);

CREATE INDEX file_receive_chunks_file_idx ON file_receive_chunks(file_id);

CREATE TABLE pending_file_requests (
    file_id TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL,
    next_attempt_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE file_incoming_transfers (
    transfer_id TEXT NOT NULL PRIMARY KEY,
    file_id TEXT NOT NULL,
    author_device TEXT NOT NULL,
    key BLOB NOT NULL,
    chunk_size_bytes INTEGER NOT NULL,
    total_bytes INTEGER NOT NULL,
    start_index INTEGER NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX file_incoming_transfers_file_idx ON file_incoming_transfers(file_id);

CREATE TABLE file_pushes (
    transfer_id TEXT NOT NULL PRIMARY KEY,
    file_id TEXT NOT NULL,
    target_device TEXT NOT NULL,
    via_relay TEXT,
    kind TEXT NOT NULL,
    total_bytes INTEGER NOT NULL,
    key BLOB NOT NULL,
    chunk_size_bytes INTEGER NOT NULL,
    start_index INTEGER NOT NULL,
    next_chunk_index INTEGER NOT NULL,
    contiguous_acked INTEGER NOT NULL,
    marker_packet_id TEXT,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX file_pushes_file_target_idx ON file_pushes(file_id, target_device);

CREATE TABLE file_request_attempts (
    file_id TEXT NOT NULL PRIMARY KEY,
    attempts INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER NOT NULL,
    waiting_device TEXT,
    waiting_until INTEGER,
    request_transfer_id TEXT
);

CREATE TABLE file_request_declined_devices (
    file_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    PRIMARY KEY (file_id, device_id),
    FOREIGN KEY (file_id) REFERENCES file_request_attempts(file_id) ON DELETE CASCADE
);

CREATE INDEX file_request_attempts_due_idx ON file_request_attempts(next_attempt_at);

CREATE TABLE file_relay_transfers (
    transfer_id TEXT NOT NULL PRIMARY KEY,
    source_device TEXT NOT NULL,
    target_device TEXT NOT NULL,
    chunk_size_bytes INTEGER NOT NULL,
    total_bytes INTEGER NOT NULL,
    start_index INTEGER NOT NULL,
    offer_payload BLOB NOT NULL,
    status TEXT NOT NULL,
    reserved_bytes INTEGER NOT NULL,
    marker_packet_id TEXT,
    created_at INTEGER NOT NULL,
    last_chunk_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE TABLE file_relay_chunks (
    transfer_id TEXT NOT NULL,
    chunk_index INTEGER NOT NULL,
    packet_id TEXT,
    blob BLOB NOT NULL,
    PRIMARY KEY (transfer_id, chunk_index),
    FOREIGN KEY (transfer_id) REFERENCES file_relay_transfers(transfer_id) ON DELETE CASCADE
);

CREATE INDEX file_relay_chunks_transfer_idx ON file_relay_chunks(transfer_id);
