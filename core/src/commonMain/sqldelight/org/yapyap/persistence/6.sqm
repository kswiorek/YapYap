-- File transfer (docs/file/design.md §13): drops the placeholder file tables and creates
-- the attachment index, the orchestrator's store, receive and request state, and routing's
-- push, incoming, pull and relay state. Runs with foreign keys off (see DatabaseInitializer).
DROP INDEX IF EXISTS file_chunk_tracker_status_idx;
DROP INDEX IF EXISTS file_transfers_message_idx;
DROP TABLE IF EXISTS file_chunk_tracker;
DROP TABLE IF EXISTS file_transfers;

CREATE TABLE message_attachments (
    message_id TEXT NOT NULL,
    file_id TEXT NOT NULL,
    PRIMARY KEY (message_id, file_id),
    FOREIGN KEY (message_id) REFERENCES messages(message_id) ON DELETE CASCADE
);

CREATE INDEX message_attachments_file_idx ON message_attachments(file_id);

CREATE TABLE file_descriptors (
    file_id TEXT NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    mime_type TEXT,
    total_bytes INTEGER NOT NULL,
    block_size INTEGER NOT NULL,
    block_hashes BLOB NOT NULL,
    storage TEXT NOT NULL,
    path TEXT NOT NULL,
    storage_kind TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_access_at INTEGER NOT NULL
);

CREATE TABLE file_receives (
    file_id TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL,
    total_bytes INTEGER NOT NULL,
    contiguous_bytes INTEGER NOT NULL,
    block_size INTEGER,
    block_hashes BLOB,
    file_name TEXT,
    mime_type TEXT,
    hash_mismatches INTEGER NOT NULL,
    origin_message_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE file_receive_chunks (
    file_id TEXT NOT NULL,
    start_offset INTEGER NOT NULL,
    length INTEGER NOT NULL,
    plaintext BLOB NOT NULL,
    PRIMARY KEY (file_id, start_offset)
);

CREATE INDEX file_receive_chunks_file_idx ON file_receive_chunks(file_id);

CREATE TABLE pending_file_requests (
    file_id TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE file_incoming_seals (
    seal_id BLOB NOT NULL PRIMARY KEY,
    origin_device TEXT NOT NULL,
    file_id TEXT NOT NULL,
    seal BLOB NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX file_incoming_seals_file_idx ON file_incoming_seals(file_id);

CREATE TABLE file_incoming_transfers (
    transfer_id TEXT NOT NULL PRIMARY KEY,
    seal_id BLOB NOT NULL,
    sender_device TEXT NOT NULL,
    final_target TEXT NOT NULL,
    chunk_size INTEGER NOT NULL,
    byte_from INTEGER NOT NULL,
    byte_to INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX file_incoming_transfers_seal_idx ON file_incoming_transfers(seal_id);

CREATE TABLE file_seals (
    seal_id BLOB NOT NULL PRIMARY KEY,
    file_id TEXT NOT NULL,
    target_device TEXT NOT NULL,
    kind TEXT NOT NULL,
    seal_bytes BLOB NOT NULL,
    seal_key BLOB NOT NULL,
    total_bytes INTEGER NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    deposited_at INTEGER
);

CREATE INDEX file_seals_file_target_idx ON file_seals(file_id, target_device);

CREATE TABLE file_transfers_out (
    transfer_id TEXT NOT NULL PRIMARY KEY,
    seal_id BLOB NOT NULL,
    source_transfer_id TEXT,
    peer TEXT NOT NULL,
    chunk_size INTEGER NOT NULL,
    byte_from INTEGER NOT NULL,
    byte_to INTEGER NOT NULL,
    next_chunk_index INTEGER NOT NULL,
    contiguous_acked INTEGER NOT NULL,
    offer_packet_id TEXT,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX file_transfers_out_seal_idx ON file_transfers_out(seal_id);
CREATE INDEX file_transfers_out_source_idx ON file_transfers_out(source_transfer_id);

CREATE TABLE file_transfer_chunks (
    transfer_id TEXT NOT NULL,
    chunk_index INTEGER NOT NULL,
    packet_id TEXT NOT NULL,
    PRIMARY KEY (transfer_id, chunk_index),
    FOREIGN KEY (transfer_id) REFERENCES file_transfers_out(transfer_id) ON DELETE CASCADE
);

CREATE INDEX file_transfer_chunks_packet_idx ON file_transfer_chunks(packet_id);

CREATE TABLE file_pull_attempts (
    file_id TEXT NOT NULL PRIMARY KEY,
    attempts INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER NOT NULL,
    waiting_device TEXT,
    waiting_until INTEGER,
    request_attempt_id TEXT,
    pull_class TEXT NOT NULL
);

CREATE TABLE file_pull_declined_devices (
    file_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    PRIMARY KEY (file_id, device_id),
    FOREIGN KEY (file_id) REFERENCES file_pull_attempts(file_id) ON DELETE CASCADE
);

CREATE INDEX file_pull_attempts_due_idx ON file_pull_attempts(next_attempt_at);

CREATE TABLE file_relay_seals (
    transfer_id TEXT NOT NULL PRIMARY KEY,
    seal_bytes BLOB NOT NULL,
    stored_at INTEGER NOT NULL,
    FOREIGN KEY (transfer_id) REFERENCES file_incoming_transfers(transfer_id) ON DELETE CASCADE
);

CREATE TABLE file_relay_chunks (
    transfer_id TEXT NOT NULL,
    chunk_index INTEGER NOT NULL,
    stored_at INTEGER NOT NULL,
    ciphertext BLOB NOT NULL,
    PRIMARY KEY (transfer_id, chunk_index),
    FOREIGN KEY (transfer_id) REFERENCES file_incoming_transfers(transfer_id) ON DELETE CASCADE
);

-- The outbox is not a file table, so its retry class arrives as ALTER TABLE plus the
-- column in Outbox.sq: chunk rows retry at their own flat delay (design §6.2), while
-- OFFERs and REQUESTs keep the message schedule.
ALTER TABLE outbox ADD COLUMN retry_class INTEGER NOT NULL DEFAULT 0;
