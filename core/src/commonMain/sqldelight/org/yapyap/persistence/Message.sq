import kotlin.Boolean;
import org.yapyap.persistence.db.MessageLifecycleState;
import org.yapyap.persistence.db.MessagePayloadType;

CREATE TABLE messages (
    message_id TEXT NOT NULL PRIMARY KEY,
    room_id TEXT NOT NULL,
    sender_account_id TEXT NOT NULL,
    author_device_id TEXT NOT NULL,
    prev_id TEXT,
    lamport_clock INTEGER NOT NULL,
    created_at_epoch_seconds INTEGER NOT NULL,
    payload_type TEXT AS MessagePayloadType NOT NULL,
    message_payload BLOB NOT NULL,
    lifecycle_state TEXT AS MessageLifecycleState NOT NULL,
    is_orphaned INTEGER AS Boolean NOT NULL,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id),
    FOREIGN KEY (sender_account_id) REFERENCES accounts(account_id),
    FOREIGN KEY (author_device_id) REFERENCES devices(device_id)
);

CREATE TABLE causal_hold (
    gap_id TEXT NOT NULL PRIMARY KEY,
    missing_prev_id TEXT NOT NULL,
    orphaned_message_id TEXT NOT NULL,
    detected_timestamp INTEGER NOT NULL,
    FOREIGN KEY (orphaned_message_id) REFERENCES messages(message_id)
);

CREATE INDEX messages_room_lamport_idx ON messages(room_id, lamport_clock);
CREATE INDEX messages_sender_idx ON messages(sender_account_id);
CREATE INDEX messages_author_device_idx ON messages(author_device_id);
CREATE INDEX messages_prev_idx ON messages(prev_id);
CREATE INDEX messages_room_display_order_idx ON messages(
    room_id,
    created_at_epoch_seconds DESC,
    lamport_clock DESC,
    message_id DESC
);
CREATE INDEX causal_hold_orphan_idx ON causal_hold(orphaned_message_id);

-- Paginated room view, ordered newest -> oldest by (createdAtEpochSeconds, lamportClock, messageId).
-- Pass null cursor values to read the latest page; pass the oldest row of the previous page to load older.
selectMessagesInRoomPageDesc :
SELECT * FROM messages
WHERE room_id = :roomId
  AND (:cursorCreated IS NULL
       OR created_at_epoch_seconds < :cursorCreated
       OR (created_at_epoch_seconds = :cursorCreated AND lamport_clock < :cursorLamport)
       OR (created_at_epoch_seconds = :cursorCreated AND lamport_clock = :cursorLamport AND message_id < :cursorMessageId))
ORDER BY created_at_epoch_seconds DESC, lamport_clock DESC, message_id DESC
LIMIT :limit;

-- ---- message CRUD ----

insertMessage:
INSERT OR IGNORE INTO messages (
    message_id,
    room_id,
    sender_account_id,
    author_device_id,
    prev_id,
    lamport_clock,
    created_at_epoch_seconds,
    payload_type,
    message_payload,
    lifecycle_state,
    is_orphaned
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMessageById:
SELECT * FROM messages WHERE message_id = ?;

-- Highest-lamport message in a room; tie-break by created_at_epoch_seconds DESC, message_id DESC.
-- Used by DagEngine.append to determine the prev_id for a new message.
selectRoomTail:
SELECT * FROM messages
WHERE room_id = ?
ORDER BY lamport_clock DESC, created_at_epoch_seconds DESC, message_id DESC
LIMIT 1;

selectMaxLamportInRoom:
SELECT MAX(lamport_clock) FROM messages WHERE room_id = ?;

selectAllMessagesInRoom:
SELECT * FROM messages
WHERE room_id = ?
ORDER BY created_at_epoch_seconds DESC, lamport_clock DESC, message_id DESC;

updateMessageOrphanedFlag:
UPDATE messages SET is_orphaned = ? WHERE message_id = ?;

updateMessageLifecycleState:
UPDATE messages SET lifecycle_state = ? WHERE message_id = ?;

-- ---- causal_hold CRUD ----

insertCausalHold:
INSERT INTO causal_hold (gap_id, missing_prev_id, orphaned_message_id, detected_timestamp)
VALUES (?, ?, ?, ?);

selectCausalHoldsByMissingPrevId:
SELECT * FROM causal_hold WHERE missing_prev_id = ?;

selectCausalHoldsByRoom:
SELECT c.* FROM causal_hold c
JOIN messages m ON c.orphaned_message_id = m.message_id
WHERE m.room_id = ?;

selectAllCausalHolds:
SELECT * FROM causal_hold;

deleteCausalHoldsByMissingPrevId:
DELETE FROM causal_hold WHERE missing_prev_id = ?;

deleteCausalHoldByOrphanedMessageId:
DELETE FROM causal_hold WHERE orphaned_message_id = ?;