import kotlin.Boolean;
import kotlin.time.Instant;
import kotlin.uuid.Uuid;
import org.yapyap.crypto.identity.AccountId;
import org.yapyap.orchestrator.dag.RoomId;
import org.yapyap.persistence.db.MessagePayloadType;
import org.yapyap.persistence.db.VerificationState;
import org.yapyap.protocol.PeerId;

CREATE TABLE messages (
    message_id TEXT AS Uuid NOT NULL PRIMARY KEY,
    room_id TEXT AS RoomId NOT NULL,
    sender_account_id TEXT AS AccountId NOT NULL,
    author_device_id TEXT AS PeerId NOT NULL,
    verification_state TEXT AS VerificationState NOT NULL,
    created_at_epoch_seconds INTEGER AS Instant NOT NULL,
    payload_type TEXT AS MessagePayloadType NOT NULL,
    message_payload BLOB NOT NULL,
    is_orphaned INTEGER AS Boolean NOT NULL,
    -- Transitively complete ancestry: every parent present and itself complete.
    -- Maintained by DagEngine (set at insert, re-derived at gap closure).
    -- Conjunction with verification_state != 'REJECTED' defines a chainable message.
    ancestry_complete INTEGER AS Boolean NOT NULL,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id)
);

-- DAG parent edges. A message with no rows here is the room's DAG root (genesis).
CREATE TABLE message_parents (
    message_id TEXT AS Uuid NOT NULL,
    parent_id TEXT AS Uuid NOT NULL,
    PRIMARY KEY (message_id, parent_id),
    FOREIGN KEY (message_id) REFERENCES messages(message_id)
);

CREATE TABLE causal_hold (
    gap_id TEXT AS Uuid NOT NULL PRIMARY KEY,
    missing_prev_id TEXT AS Uuid NOT NULL,
    orphaned_message_id TEXT AS Uuid NOT NULL,
    detected_timestamp INTEGER AS Instant NOT NULL,
    FOREIGN KEY (orphaned_message_id) REFERENCES messages(message_id)
);

CREATE INDEX messages_sender_idx ON messages(sender_account_id);
CREATE INDEX messages_author_device_idx ON messages(author_device_id);
CREATE INDEX message_parents_parent_idx ON message_parents(parent_id);
CREATE INDEX messages_room_display_order_idx ON messages(
    room_id,
    created_at_epoch_seconds DESC,
    message_id DESC
);
CREATE INDEX causal_hold_orphan_idx ON causal_hold(orphaned_message_id);

-- Paginated room view, ordered newest -> oldest by (createdAtEpochSeconds, messageId).
-- Pass null cursor values to read the latest page; pass the oldest row of the previous page to load older.
selectMessagesInRoomPageDesc :
SELECT * FROM messages
WHERE room_id = :roomId
  AND verification_state != 'REJECTED'
  AND ((:cursorCreated IS NULL AND :cursorMessageId IS NULL) OR
       (created_at_epoch_seconds, message_id) <
       (:cursorCreated, :cursorMessageId))
ORDER BY created_at_epoch_seconds DESC, message_id DESC
LIMIT :limit;

-- ---- message CRUD ----

insertMessage:
INSERT OR IGNORE INTO messages (
    message_id,
    room_id,
    sender_account_id,
    author_device_id,
    verification_state,
    created_at_epoch_seconds,
    payload_type,
    message_payload,
    is_orphaned,
    ancestry_complete
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMessageById:
SELECT * FROM messages WHERE message_id = ?;

-- Chainable frontier (covering antichain): chainable messages that no chainable
-- message references as a parent. Used by DagEngine.append and as the sync/ping
-- stop set (below a frontier tip everything is present by transitivity).
-- Parked orphan tips are excluded and rejoin automatically once their gap closes.
selectRoomFrontier:
SELECT * FROM messages m
WHERE m.room_id = :roomId
  AND m.ancestry_complete = 1
  AND m.verification_state != 'REJECTED'
  AND NOT EXISTS (
    SELECT 1 FROM message_parents mp
    JOIN messages c ON c.message_id = mp.message_id
    WHERE mp.parent_id = m.message_id
      AND c.room_id = m.room_id
      AND c.ancestry_complete = 1
      AND c.verification_state != 'REJECTED'
  );

updateMessageVerificationState:
UPDATE messages SET verification_state = ? WHERE message_id = ?;

selectPendingByAuthor:
SELECT * FROM messages
WHERE author_device_id = ? AND verification_state = 'PENDING';

selectAllPending:
SELECT * FROM messages WHERE verification_state = 'PENDING';

-- True (1) if the room holds any message at all (used for genesis/empty-room checks).
selectHasMessagesInRoom:
SELECT EXISTS(SELECT 1 FROM messages WHERE room_id = ?);

-- Newest non-rejected message; append-guard fallback only (all tips parked).
selectLatestInRoom:
SELECT * FROM messages
WHERE room_id = ?
  AND verification_state != 'REJECTED'
ORDER BY created_at_epoch_seconds DESC, message_id DESC
LIMIT 1;

selectAllMessagesInRoom:
SELECT * FROM messages
WHERE room_id = ?
ORDER BY created_at_epoch_seconds DESC, message_id DESC;

updateMessageOrphanedFlag:
UPDATE messages SET is_orphaned = ? WHERE message_id = ?;

updateMessageAncestryComplete:
UPDATE messages SET ancestry_complete = ? WHERE message_id = ?;

-- ---- message_parents CRUD ----

insertMessageParent:
INSERT OR IGNORE INTO message_parents (message_id, parent_id)
VALUES (?, ?);

selectParentsByMessage:
SELECT parent_id FROM message_parents WHERE message_id = ?;

selectChildrenInRoom:
SELECT m.* FROM messages m
JOIN message_parents mp ON mp.message_id = m.message_id
WHERE mp.parent_id = :parentId AND m.room_id = :roomId;

-- ---- causal_hold CRUD ----

insertCausalHold:
INSERT INTO causal_hold (gap_id, missing_prev_id, orphaned_message_id, detected_timestamp)
VALUES (?, ?, ?, ?);

selectCausalHoldsByMissingPrevId:
SELECT * FROM causal_hold WHERE missing_prev_id = ?;

selectCausalHoldsByRoom:
SELECT c.* FROM causal_hold c
JOIN messages m ON c.orphaned_message_id = m.message_id
WHERE m.room_id = ?;

selectCausalHoldCountByOrphan:
SELECT COUNT(*) FROM causal_hold WHERE orphaned_message_id = ?;

selectAllCausalHolds:
SELECT * FROM causal_hold;

deleteCausalHoldsByMissingPrevId:
DELETE FROM causal_hold WHERE missing_prev_id = ?;

deleteCausalHoldByOrphanedMessageId:
DELETE FROM causal_hold WHERE orphaned_message_id = ?;
