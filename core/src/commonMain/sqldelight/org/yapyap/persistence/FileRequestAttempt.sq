import kotlin.uuid.Uuid;
import kotlin.time.Instant;
import org.yapyap.protocol.FileId;
import org.yapyap.protocol.PeerId;

-- Router-owned: how a pending file request is being asked for. Mirrors SyncAttempt.sq,
-- keyed by fileId instead of syncId, plus the WAITING state (ACK received, OFFER pending)
-- and the in-flight REQUEST's transferId for outcome correlation.
CREATE TABLE file_request_attempts(
    file_id TEXT AS FileId NOT NULL PRIMARY KEY,
    attempts INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER AS Instant NOT NULL,
    waiting_device TEXT AS PeerId,
    waiting_until INTEGER AS Instant,
    request_transfer_id TEXT
);

CREATE TABLE file_request_declined_devices(
    file_id TEXT AS FileId NOT NULL,
    device_id TEXT AS PeerId NOT NULL,
    PRIMARY KEY (file_id, device_id),
    FOREIGN KEY (file_id) REFERENCES file_request_attempts(file_id) ON DELETE CASCADE
);

insertFileRequestAttempt:
INSERT OR IGNORE INTO file_request_attempts (file_id, attempts, next_attempt_at)
VALUES (?, 0, ?);

deleteFileRequestAttempt:
DELETE FROM file_request_attempts WHERE file_id = ?;

selectEarliestDueFileRequestAt:
SELECT MIN(next_attempt_at) FROM file_request_attempts;

selectDueFileRequestAttempts:
SELECT * FROM file_request_attempts WHERE next_attempt_at <= ? LIMIT ?;

recordFileRequestAttempt:
UPDATE file_request_attempts SET attempts = attempts + 1, next_attempt_at = ? WHERE file_id = ?;

updateFileRequestNextAttemptAt:
UPDATE file_request_attempts SET next_attempt_at = ? WHERE file_id = ?;

-- Brings the given files forward to :now; never pushes one back.
advanceFileRequestsToNow:
UPDATE file_request_attempts SET next_attempt_at = :now
WHERE next_attempt_at > :now AND file_id IN :fileIds;

selectFileRequestById:
SELECT * FROM file_request_attempts WHERE file_id = ?;

selectFileRequestByTransferId:
SELECT * FROM file_request_attempts WHERE request_transfer_id = ?;

setFileRequestWaiting:
UPDATE file_request_attempts
SET waiting_device = ?, waiting_until = ?, request_transfer_id = ?
WHERE file_id = ?;

clearFileRequestWaiting:
UPDATE file_request_attempts
SET waiting_device = NULL, waiting_until = NULL, request_transfer_id = NULL
WHERE file_id = ?;

setFileRequestTransfer:
UPDATE file_request_attempts SET request_transfer_id = ? WHERE file_id = ?;

selectDeclinedFileRequestDevices:
SELECT device_id FROM file_request_declined_devices WHERE file_id = ?;

insertDeclinedFileRequestDevice:
INSERT OR IGNORE INTO file_request_declined_devices (file_id, device_id) VALUES (?, ?);

selectAllFileRequestIds:
SELECT file_id FROM file_request_attempts;

deleteDeclinedFileRequestDevices:
DELETE FROM file_request_declined_devices WHERE file_id = :fileId AND device_id IN :deviceIds;

CREATE INDEX file_request_attempts_due_idx ON file_request_attempts(next_attempt_at);
